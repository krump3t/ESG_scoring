# ============================================================================
# ESG Evaluation Platform - Environment Configuration Template
# ============================================================================
#
# IMPORTANT: Never commit .env.production to git!
#
# Setup Instructions:
# 1. Copy this file to .env.production
# 2. Replace all REPLACE_WITH_YOUR_* placeholders with actual values
# 3. Keep .env.production secure and never commit it to version control
#
# For detailed security guidelines, see SECURITY.md
# ============================================================================

# ============================================================================
# Determinism & Reproducibility
# ============================================================================

# Random seed for reproducible results across runs
SEED=42

# Python hash seed for deterministic dictionary ordering
PYTHONHASHSEED=0

# ============================================================================
# IBM watsonx.ai Configuration
# ============================================================================

# watsonx API Key - Get from IBM Cloud Console
# https://cloud.ibm.com/iam/apikeys
IBM_WATSONX_API_KEY=REPLACE_WITH_YOUR_WATSONX_API_KEY
WATSONX_API_KEY=REPLACE_WITH_YOUR_WATSONX_API_KEY

# watsonx Project ID - Find in your watsonx.ai project settings
IBM_WATSONX_PROJECT_ID=REPLACE_WITH_YOUR_WATSONX_PROJECT_ID
WATSONX_PROJECT_ID=REPLACE_WITH_YOUR_WATSONX_PROJECT_ID

# watsonx API URL - Default US South region
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# watsonx Generation Model ID
WATSONX_GEN_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# Offline replay mode for testing without API calls (true/false)
WX_OFFLINE_REPLAY=false

# ============================================================================
# DataStax Astra DB Configuration (Vector Database)
# ============================================================================

# Astra DB Application Token - Generate from Astra Console
# https://astra.datastax.com/org/<your-org>/settings/tokens
ASTRA_DB_APPLICATION_TOKEN=REPLACE_WITH_YOUR_ASTRA_TOKEN
ASTRA_DB_TOKEN=REPLACE_WITH_YOUR_ASTRA_TOKEN

# Astra DB Database ID (UUID format)
ASTRA_DB_ID=REPLACE_WITH_YOUR_DATABASE_ID
ASTRA_DB_DATABASE_ID=REPLACE_WITH_YOUR_DATABASE_ID

# Astra DB Region (e.g., us-east1, us-east-2)
ASTRA_DB_REGION=us-east1

# Astra DB Keyspace name
ASTRA_DB_KEYSPACE=default_keyspace

# Astra DB API Endpoint (constructed from DB ID and region)
ASTRA_DB_API_ENDPOINT=https://REPLACE_WITH_YOUR_DATABASE_ID-REPLACE_WITH_YOUR_REGION.apps.astra.datastax.com

# Astra DB Collection name for vector storage
ASTRA_DB_COLLECTION=esg_documents

# ============================================================================
# Embedding Configuration
# ============================================================================

# Use live embeddings API (true) or cached embeddings (false)
LIVE_EMBEDDINGS=false
ALLOW_NETWORK=true

# Embedding model to use
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================================
# MinIO Object Storage (S3-Compatible)
# ============================================================================

# MinIO Access Credentials
# IMPORTANT: Never use default credentials like "minioadmin" in production!
# Generate secure random credentials:
#   - Access Key: 20-40 alphanumeric characters
#   - Secret Key: 40-128 characters
#
# Example generation:
#   PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | % {[char]$_})
#   Bash: openssl rand -hex 20
MINIO_ACCESS_KEY=REPLACE_WITH_SECURE_RANDOM_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY

# ============================================================================
# DuckDB Configuration
# ============================================================================

# Path to DuckDB database file (relative or absolute)
DUCKDB_PATH=./data/esg_evaluation.duckdb

# Base path for parquet file storage
PARQUET_BASE_PATH=./data_lake/bronze

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis host (use 'redis' for Docker, 'localhost' for local development)
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================================
# Apache Airflow Configuration
# ============================================================================

# Airflow Fernet encryption key for encrypting sensitive data
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=REPLACE_WITH_FERNET_KEY

# Airflow executor (LocalExecutor, CeleryExecutor, etc.)
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Airflow database connection string
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# ============================================================================
# ngrok Configuration (Public HTTPS Tunnel)
# ============================================================================

# ngrok authentication token - Get from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=REPLACE_WITH_YOUR_NGROK_AUTHTOKEN

# ============================================================================
# MCP API Configuration
# ============================================================================

# MCP API authentication key
MCP_API_KEY=REPLACE_WITH_YOUR_MCP_API_KEY

# MCP rate limiting (requests per minute)
MCP_RATE_LIMIT=100

# ============================================================================
# SEC EDGAR Configuration
# ============================================================================

# User agent for SEC EDGAR API requests (required by SEC)
# Format: CompanyName/AppName/Version (Contact: email; Purpose: description)
SEC_USER_AGENT=IBM-ESG/ScoringApp/0.1 (Contact: your-email@example.com; Purpose: EDGAR 10-K fetch for ESG maturity demo)

# ============================================================================
# Secret Management
# ============================================================================

# Secret manager backend (none, aws, azure, vault)
SECRETS_MANAGER=none

# AWS region (if using AWS Secrets Manager)
AWS_REGION=us-east-1

# ============================================================================
# Infrastructure Validation
# ============================================================================

# Docker version requirements
DOCKER_REQUIRED=true
DOCKER_MIN_VERSION=20.10.0

# Network connectivity tests
DNS_TEST_HOST=google.com
HTTP_TEST_URL=https://www.google.com
NETWORK_LATENCY_THRESHOLD_MS=500

# Time synchronization
NTP_SERVER=pool.ntp.org
CLOCK_DRIFT_THRESHOLD_SECONDS=5

# Writable directories for validation (comma-separated)
WRITABLE_DIRS=./data,./logs,./artifacts

# ============================================================================
# Logging & Observability
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log directory
LOG_DIR=./logs

# Log format (json, text)
LOG_FORMAT=json

# Enable distributed trace IDs for request tracking
ENABLE_TRACE_IDS=true

# ============================================================================
# Security & CORS
# ============================================================================

# Allowed CORS origins (comma-separated, or * for all)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# Development & Testing
# ============================================================================

# Environment name (development, staging, production)
ENVIRONMENT=development

# ============================================================================
# SECURITY REMINDERS
# ============================================================================
#
# 1. NEVER commit .env.production to git
# 2. Rotate credentials quarterly (see SECURITY.md)
# 3. Use strong, randomly-generated credentials
# 4. Different credentials for dev/staging/production
# 5. Use secret manager in production (AWS Secrets Manager, HashiCorp Vault)
# 6. Review access logs regularly
# 7. Revoke compromised credentials immediately
#
# For credential rotation procedures, see SECURITY.md
# For incident response, see SECURITY.md
#
# ============================================================================
